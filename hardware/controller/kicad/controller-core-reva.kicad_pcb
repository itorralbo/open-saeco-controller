	(footprint "OpenSaeco:LEOCO_3941P03_1x03_P3.96mm_Vertical"
		(layer "F.Cu")
		(uuid "4b61254c-1e93-4741-97be-d1c5f290c2bf")
		(at 59.04 122.15)
		(descr "LEOCO 3941P03*000 (3941 V series), 3.96 mm pitch friction-lock header, vertical THT, 3 circuits, 7 A 250 V; not stocked by JLCPCB. From LEOCO drawing 394105S rev F: 1.14 mm pins, recommended holes 1.80 mm for the square pin (V) and 1.40 mm for the round pin (R); the 1.80 mm hole takes either. Housing 11.9 x 9.6 mm, pin row 4.80 mm from the flat back. JP8 grinder, 320 V DC. Circuit 1 is pad 1 at the origin; the flat back faces north and the lock hook south, as the third-angle front view of the drawing gives it.")
