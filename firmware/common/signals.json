{
  "_doc": "Firmware <-> board contract (sim/README.md). Each signal names the net the firmware drives or reads; the MCU pin, peripheral and alternate function are resolved from the KiCad netlists by tools/build_board_model.py, which also generates the board_pins.h headers. Endpoints are 'board:REF.PIN'. Numbers marked TBD in the docs stay as ranges to be revised.",
  "boards": {
    "controller": "hardware/controller/validation/netlist.xml",
    "front": "hardware/front-panel/validation/netlist.xml"
  },
  "harness": [
    {"name": "UI_LINK", "a": "controller:J104", "b": "front:J1", "map": "1:1", "pins": 16}
  ],
  "rails": {
    "controller:GND_UI": 0.0,
    "controller:3V3_CORE": 3.3,
    "controller:3V3_UI": 3.3,
    "controller:12V_PROTECTED": 12.0,
    "controller:24V_ACT_RAW": 24.0,
    "controller:24V_VALVE": 24.0,
    "controller:24V_BREW": 24.0,
    "controller:LOAD_L_ENABLED": null,
    "controller:MAINS_L_FUSED": null,
    "controller:MAINS_N": null,
    "controller:PROTECTIVE_EARTH": null
  },
  "rail_range": {
    "_doc": "Worst-case span of each supply for the F1 drive check [min, max]. 3V3_UI follows U302.",
    "controller:3V3_CORE": [3.2, 3.4],
    "controller:12V_PROTECTED": [11.0, 12.5],
    "controller:24V_ACT_RAW": [21.6, 28.0],
    "controller:24V_BREW": [21.0, 27.7],
    "controller:24V_VALVE": [21.0, 27.7],
    "controller:USB_VBUS": [4.75, 5.5],
    "sources": "AP63203 VFB 3.27-3.33 V plus ripple; U303 11.8 V (VFB 0.792-0.808 V, 1 % divider) or the J101 bench supply, less D301; IRM-30-24 24 V -10 %/+10 % plus margin, as RAIL_24V; 24V_BREW and 24V_VALVE less one SS34; USB VBUS 5 V -5 %/+10 % with a service cable plugged"
  },
  "mains": {"phase": "controller:MAINS_L_FUSED", "neutral": "controller:MAINS_N", "prospective_fault": {"amps": 1500, "volts": 250, "source": "Design assumption accepted by the owner on 2026-10-07, not a measured maximum (issue #1; hardware/power/power-architecture.md, Corriente de defecto supuesta): the IEC 60127-2 high-breaking-capacity level, 1500 A at 250 VAC, the class of the original board's mains fuses. Above it the installation's 16 A breaker backs the fuse up. Every fuse on the mains side must break it."}},
  "external_limits": [
    {"pin": "controller:J106.3", "volts": 20.0, "source": "Digmesa FHKSC 932-9521-B supply 3.8-20 V (docs/verification.md)"}
  ],
  "external_supplies": {
    "_doc": "Bench and service inputs that may be live while the on-board converters are not.",
    "pins": ["controller:J101.1", "controller:J112.1", "controller:J110.A4"]
  },
  "loads": [
    {"name": "electroválvula", "between": ["controller:J113.1", "controller:J113.2"], "ohms": 56.7},
    {"name": "motor del grupo", "between": ["controller:J108.1", "controller:J108.2"], "ohms": 54.7}
  ],
  "interlock_net": "controller:STM_NRST",
  "mcus": {
    "stm32": {
      "ref": "controller:U101",
      "vdd": "controller:3V3_CORE",
      "vref": 3.3,
      "adc_bits": 12,
      "header": "firmware/stm32/include/board_pins.h",
      "system_nets": ["3V3_CORE", "GND_UI", "STM_NRST", "STM_BOOT0", "STM_SWDIO", "STM_SWCLK", "STM_SWO"],
      "signals": [
        {"name": "HEATER_EN", "net": "HEATER_EN_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:J116.1", "interlocked": true,
         "drive": {"with": ["MAINS_ARM"], "load": "controller:J116.1", "on": "live"}},
        {"name": "PUMP_EN", "net": "PUMP_EN_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:J117.1", "interlocked": true,
         "drive": {"with": ["MAINS_ARM"], "load": "controller:J117.1", "on": "live"}},
        {"name": "GRINDER_EN", "net": "GRINDER_EN_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:J115.1", "interlocked": true,
         "drive": {"with": ["MAINS_ARM"], "load": "controller:J115.1", "on": "live"}},
        {"name": "MAINS_ARM", "net": "MAINS_ARM_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:Q703.A2", "interlocked": true,
         "drive": {"load": "controller:Q703.A2", "on": "live"}},
        {"name": "VALVE_EN", "net": "VALVE_EN_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:J113.2", "interlocked": true,
         "drive": {"load": "controller:J113.2", "on": "low", "supply": "controller:24V_VALVE"}},
        {"name": "BREW_PWM", "net": "BREW_PWM_RAW", "function": "pwm", "periph": "TIM1_CH3N", "active": "high", "reset": "low",
         "reaches": "controller:J108.2",
         "drive": {"with": ["BREW_SLEEP_N"], "load": "controller:J108.1", "on": "high", "supply": "controller:24V_BREW"}},
        {"name": "BREW_DIR", "net": "BREW_DIR_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:J108.1",
         "drive": {"with": ["BREW_SLEEP_N", "BREW_PWM"], "load": "controller:J108.2", "on": "high", "supply": "controller:24V_BREW"}},
        {"name": "BREW_SLEEP_N", "net": "BREW_SLEEP_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:J108.2", "interlocked": true,
         "drive": {"with": ["BREW_PWM"], "load": "controller:J108.1", "on": "high", "supply": "controller:24V_BREW"}},
        {"name": "BREW_FAULT_N", "net": "BREW_FAULT_N", "function": "gpio_in", "active": "low",
         "from": "controller:U501.nFAULT", "pull": "up"},
        {"name": "BREW_CURRENT", "net": "BREW_CURRENT_ADC", "function": "adc",
         "from": "controller:U501.IPROPI",
         "analog": {"kind": "ipropi", "gain_a_per_a": 0.001, "vref_net": "controller:BREW_VREF",
                    "source": "TI SLVSDS7B: AIPROPI 1000 uA/A, regulation when V(IPROPI) > V(VREF), VREF <= 3.6 V"}},
        {"name": "WDT_KICK", "net": "WATCHDOG_KICK_RAW", "function": "gpio_out", "active": "high", "reset": "low",
         "reaches": "controller:U601.WDI"},
        {"name": "UI_PWR_EN", "net": "UI_PWR_EN", "function": "gpio_out", "active": "high", "reset": "high",
         "reaches": "controller:J104.1",
         "drive": {"load": "controller:J104.1", "on": "high", "supply": "controller:3V3_CORE"}},
        {"name": "NTC", "net": "NTC_ADC", "function": "adc", "from": "controller:J105.1",
         "analog": {"kind": "ntc", "between": ["controller:J105.1", "controller:J105.2"],
                    "r25": 49900, "beta": 4037, "range_c": [0, 150], "check_c": [90, 125],
                    "max_c_per_lsb": 0.5, "window": [0.02, 0.98],
                    "source": "docs/HD8911/components.md: R25 ~ 49.9 kOhm, B ~ 4037 K (fit)"}},
        {"name": "FLOW", "net": "FLOW_TIM", "function": "tim_in", "periph": "TIM2_CH3", "active": "low",
         "from": "controller:J106.1", "pull": "up"},
        {"name": "DOOR_CLOSED_N", "net": "DOOR_CLOSED_N", "function": "gpio_in", "active": "low",
         "from": "controller:J107.1", "pull": "up"},
        {"name": "BU_PRESENT_N", "net": "BU_PRESENT_N", "function": "gpio_in", "active": "low",
         "from": "controller:J108.6", "pull": "up"},
        {"name": "BU_WORK_N", "net": "BU_WORK_N", "function": "gpio_in", "active": "low",
         "from": "controller:J108.8", "pull": "up"},
        {"name": "WATER_LEVEL", "net": "WATER_LEVEL", "function": "adc", "from": "controller:J109.2"},
        {"name": "GRINDER_CURRENT", "net": "GRINDER_CURRENT_ADC", "function": "adc",
         "from": "controller:U704.VOUT",
         "analog": {"kind": "hall", "device": "controller:U704", "senses": "controller:J115.1", "range_a": [0, 4.8],
                    "source": "JP8 + line through U704 (TMCS1133B4A); 4.8 A is the stall peak, 230 V x 1.41 / 68 Ohm (hardware/power/power-architecture.md)"}},
        {"name": "RAIL_12V", "net": "RAIL_12V_ADC", "function": "adc", "from": "controller:J114.5",
         "analog": {"kind": "divider", "source_net": "controller:12V_PROTECTED", "range_v": [0, 15],
                    "source": "SMAJ15A (D302) standoff voltage as the highest steady input"}},
        {"name": "RAIL_24V", "net": "RAIL_24V_ADC", "function": "adc", "from": "controller:J114.6",
         "analog": {"kind": "divider", "source_net": "controller:24V_ACT_RAW", "range_v": [0, 28],
                    "source": "IRM-30-24 at its +10 % trim plus margin; J112 bench supply alike"}},
        {"name": "UART_TX", "net": "STM_TX_RAW", "function": "uart_tx", "periph": "USART1_TX",
         "reaches": "esp32:UART_RX"},
        {"name": "UART_RX", "net": "ESP_TO_STM", "function": "uart_rx", "periph": "USART1_RX",
         "from": "esp32:UART_TX"}
      ]
    },
    "esp32": {
      "ref": "controller:U201",
      "vdd": "controller:3V3_CORE",
      "header": "firmware/esp32/main/board_pins.h",
      "system_nets": ["3V3_CORE", "GND_UI", "ESP_EN", "ESP_BOOT0", "ESP_DEBUG_TX", "ESP_DEBUG_RX"],
      "signals": [
        {"name": "LCD_SCLK", "net": "SCLK_RAW", "function": "spi_sclk", "reaches": "front:J2.4"},
        {"name": "LCD_MOSI", "net": "MOSI_RAW", "function": "spi_mosi", "reaches": "front:J2.3"},
        {"name": "LCD_CS_N", "net": "CS_RAW", "function": "spi_cs", "active": "low", "reset": "high", "reaches": "front:J2.5"},
        {"name": "LCD_DC", "net": "DC_RAW", "function": "gpio_out", "reaches": "front:J2.6"},
        {"name": "LCD_RST_N", "net": "RST_RAW", "function": "gpio_out", "active": "low", "reset": "high", "reaches": "front:J2.7"},
        {"name": "LCD_BL", "net": "BL_RAW", "function": "ledc", "active": "high", "reset": "low", "reaches": "front:J2.8"},
        {"name": "KEY_SCL", "net": "KEY_SCL", "function": "i2c_scl", "reaches": "front:U1.SCL", "pull": "up"},
        {"name": "KEY_SDA", "net": "KEY_SDA", "function": "i2c_sda", "reaches": "front:U1.SDA", "pull": "up"},
        {"name": "KEY_INT_N", "net": "KEY_INT_N", "function": "gpio_in", "active": "low", "from": "front:U1.~{INT}", "pull": "up"},
        {"name": "UART_TX", "net": "ESP_TX_RAW", "function": "uart_tx", "reaches": "stm32:UART_RX"},
        {"name": "UART_RX", "net": "STM_TO_ESP", "function": "uart_rx", "from": "stm32:UART_TX"},
        {"name": "USB_DM", "net": "USB_DM_RAW", "function": "usb_dm", "reaches": "controller:J110.A7"},
        {"name": "USB_DP", "net": "USB_DP_RAW", "function": "usb_dp", "reaches": "controller:J110.A6"},
        {"name": "VBUS_SENSE", "net": "USB_VBUS_SENSE", "function": "gpio_in", "active": "high", "from": "controller:J110.A4"}
      ]
    }
  },
  "keypad": {
    "device": "front:U1",
    "bus": ["esp32:KEY_SCL", "esp32:KEY_SDA"],
    "address": "0x20",
    "keys": {"P0": "SW1", "P1": "SW2", "P2": "SW3", "P3": "SW4", "P4": "SW5", "P5": "SW6", "P6": "SW7"},
    "leds": {"P7": "D1"},
    "source": "hardware/front-panel/layout.md, Teclas, LED y registros del TCA9534"
  }
}
